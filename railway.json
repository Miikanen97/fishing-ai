{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {"builder": "RAILPACK", "buildCommand": "python manage.py collectstatic --noinput"},
  "deploy": {
    "preDeployCommand": ["python manage.py migrate --noinput"],
    "startCommand": "gunicorn fishing_ai.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --threads 2 --timeout 120 --access-logfile - --error-logfile -"
  }
}
