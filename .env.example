# Esimerkki, ei ladata automaattisesti. Aseta muuttujat prosessin ympäristöön.
# Paikallinen kehitys:
DJANGO_ENV=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
DJANGO_SECRET_KEY=
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Railway: DJANGO_ENV=production, DEBUG=False
# ALLOWED_HOSTS=oma-palvelu.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://oma-palvelu.up.railway.app
# DATABASE_URL asetetaan Railwayn PostgreSQL-palveluviittauksena.
# DJANGO_SECRET_KEY ja OPENAI_API_KEY asetetaan Railwayn salaisina muuttujina.
# PORT: Railway asettaa automaattisesti.
