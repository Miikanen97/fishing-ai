{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FishingAI knowledge bundle v1",
  "$defs": {
    "quantity": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "degC",
            "m",
            "cm",
            "m/s",
            "mm/h",
            "hPa",
            "hPa/h",
            "percent",
            "hour"
          ]
        }
      },
      "required": [
        "min",
        "max",
        "unit"
      ],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "retired"
          ]
        },
        "species": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "when": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              {
                "$ref": "#/$defs/quantity"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "recommend": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              {
                "$ref": "#/$defs/quantity"
              }
            ]
          },
          "minProperties": 1
        },
        "reason_fi": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unknown_policy": {
          "enum": [
            "skip",
            "conditional_only"
          ]
        },
        "conflict_group": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": [
        "id",
        "version",
        "status",
        "species",
        "when",
        "requires",
        "recommend",
        "reason_fi",
        "evidence_type",
        "source_ids",
        "unknown_policy",
        "conflict_group"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "source_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "catalog": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "groups": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "condition_fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "category"
                  },
                  "catalog_group": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                },
                "required": [
                  "kind",
                  "catalog_group"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "quantity"
                  },
                  "unit": {
                    "enum": [
                      "degC",
                      "m",
                      "cm",
                      "m/s",
                      "mm/h",
                      "hPa",
                      "hPa/h",
                      "percent",
                      "hour"
                    ]
                  },
                  "minimum": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "maximum": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "unit",
                  "minimum",
                  "maximum"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "recommendation_fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "category"
                  },
                  "catalog_group": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                },
                "required": [
                  "kind",
                  "catalog_group"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "quantity"
                  },
                  "unit": {
                    "enum": [
                      "degC",
                      "m",
                      "cm",
                      "m/s",
                      "mm/h",
                      "hPa",
                      "hPa/h",
                      "percent",
                      "hour"
                    ]
                  },
                  "minimum": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "maximum": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "unit",
                  "minimum",
                  "maximum"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "unknown_value": {
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "groups",
        "condition_fields",
        "recommendation_fields",
        "unknown_value"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "accessed_on": {
          "type": "string",
          "format": "date"
        },
        "evidence_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "scope_fi": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "accessed_on",
        "evidence_type",
        "scope_fi",
        "locator"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "sources"
      ],
      "additionalProperties": false
    },
    "rule_file": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "scope": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "scope",
        "rules"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "catalog": {
      "$ref": "#/$defs/catalog"
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "rule_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule_file"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "catalog",
    "sources",
    "rule_files"
  ],
  "additionalProperties": false
}
